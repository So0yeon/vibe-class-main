# Notion → Supabase 1회 이전용 (scripts/migrate-from-notion.mjs). 이전 후에는 필요 없습니다.
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_ABOUT_PAGE_ID=

# 사이트 주소 (로컬: http://localhost:3000, Vercel: https://vibe-class-main.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Supabase (게임 목록 / 소개 / 조회수·좋아요·댓글)
# supabase/schema.sql과 supabase/content.sql을 Supabase SQL Editor에서 먼저 실행한 뒤 값을 채워주세요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 관리자 페이지 (/admin)
# SUPABASE_SERVICE_ROLE_KEY: Supabase Project Settings → API의 service_role 키.
#   서버에서만 쓰는 비밀 키입니다. 절대 NEXT_PUBLIC_을 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_PASSWORD: 관리자 로그인 비밀번호 (길고 추측하기 어렵게)
ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET: 로그인 쿠키 서명용 무작위 문자열 (32자 이상). 바꾸면 모두 로그아웃됩니다.
ADMIN_SESSION_SECRET=

# Cloudflare Web Analytics
# 로컬에는 비워두세요 (dev에서는 어차피 로드되지 않습니다). 프로덕션 호스팅
# 환경변수에만 설정하면 됩니다.
NEXT_PUBLIC_CF_BEACON_TOKEN=
